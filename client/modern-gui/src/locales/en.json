  "effectsDefinition": {
    "reverb": {
      "name": "Reverb",
      "description": "Adds room ambience and depth",
      "parameters": {
        "roomSize": {
          "name": "Room Size",
          "description": "Controls the size of the simulated room space"
        },
        "damping": {
          "name": "Damping",
          "description": "Amount of high-frequency absorption in the room"
        },
        "wetDryMix": {
          "name": "Wet/Dry Mix",
          "description": "Balance between original and reverb signal"
        },
        "preDelay": {
          "name": "Pre-delay",
          "description": "Delay before reverb starts, simulates room distance"
        }
      }
    },
    "echo": {
      "name": "Echo",
      "description": "Creates delayed repetitions",
      "parameters": {
        "delayTime": {
          "name": "Delay Time",
          "description": "Time between the original sound and the echo"
        },
        "feedback": {
          "name": "Feedback",
          "description": "How much of the echo is fed back to create repeats"
        },
        "wetLevel": {
          "name": "Wet Level",
          "description": "Volume level of the echo effect"
        },
        "highCut": {
          "name": "High Cut",
          "description": "Removes high frequencies from the echo"
        }
      }
    },
    "chorus": {
      "name": "Chorus",
      "description": "Adds richness and width",
      "parameters": {
        "rate": {
          "name": "Rate",
          "description": "Speed of the chorus modulation"
        },
        "depth": {
          "name": "Depth",
          "description": "Intensity of the pitch modulation"
        },
        "mix": {
          "name": "Mix",
          "description": "Balance between dry and chorus signal"
        },
        "voiceCount": {
          "name": "Voice Count",
          "description": "Number of virtual voices in the chorus"
        }
      }
    },
    "distortion": {
      "name": "Distortion",
      "description": "Adds harmonic saturation",
      "parameters": {
        "drive": {
          "name": "Drive",
          "description": "Amount of distortion applied to the signal"
        },
        "tone": {
          "name": "Tone",
          "description": "EQ balance from dark to bright"
        },
        "level": {
          "name": "Level",
          "description": "Output volume of the effect"
        },
        "type": {
          "name": "Type",
          "description": "Character of the distortion algorithm"
        }
      }
    },
    "compressor": {
      "name": "Compressor",
      "description": "Controls dynamic range",
      "parameters": {
        "threshold": {
          "name": "Threshold",
          "description": "Level above which compression starts"
        },
        "ratio": {
          "name": "Ratio",
          "description": "How much the signal is compressed"
        },
        "attack": {
          "name": "Attack",
          "description": "How quickly the compressor responds to loud signals"
        },
        "release": {
          "name": "Release",
          "description": "How quickly the compressor stops compressing"
        }
      }
    },
    "equalizer": {
      "name": "Equalizer",
      "description": "Adjusts frequency response",
      "parameters": {
        "low": {
          "name": "Low (80Hz)",
          "description": "Boost or cut low frequencies (bass)"
        },
        "lowMid": {
          "name": "Low-Mid (320Hz)",
          "description": "Boost or cut low-mid frequencies (warmth)"
        },
        "mid": {
          "name": "Mid (1.25kHz)",
          "description": "Boost or cut mid frequencies (presence)"
        },
        "highMid": {
          "name": "High-Mid (5kHz)",
          "description": "Boost or cut high-mid frequencies (clarity)"
        },
        "high": {
          "name": "High (12.5kHz)",
          "description": "Boost or cut high frequencies (air/brightness)"
        }
      }
    },
    "noiseGate": {
      "name": "Noise Gate",
      "description": "Eliminates unwanted background noise",
      "parameters": {
        "threshold": {
          "name": "Threshold",
          "description": "Level below which audio is gated (silenced)"
        },
        "ratio": {
          "name": "Ratio",
          "description": "How aggressively the gate closes"
        },
        "attack": {
          "name": "Attack",
          "description": "How quickly the gate opens"
        },
        "release": {
          "name": "Release",
          "description": "How quickly the gate closes"
        }
      }
    },
    "gain": {
      "name": "Gain",
      "description": "Adjusts overall volume level",
      "parameters": {
        "gain": {
          "name": "Gain",
          "description": "Amount of volume boost or cut"
        }
      }
    },
    "lowpass": {
      "name": "Low Pass Filter",
      "description": "Removes high frequencies above cutoff",
      "parameters": {
        "cutoff": {
          "name": "Cutoff Frequency",
          "description": "Frequency above which signals are filtered out"
        },
        "resonance": {
          "name": "Resonance",
          "description": "Emphasis at the cutoff frequency"
        }
      }
    },
    "highpass": {
      "name": "High Pass Filter",
      "description": "Removes low frequencies below cutoff",
      "parameters": {
        "cutoff": {
          "name": "Cutoff Frequency",
          "description": "Frequency below which signals are filtered out"
        },
        "resonance": {
          "name": "Resonance",
          "description": "Emphasis at the cutoff frequency"
        }
      }
    },
    "bitcrush": {
      "name": "Bitcrush",
      "description": "Adds lo-fi digital reduction",
      "parameters": {
        "bitDepth": {
          "name": "Bit Depth",
          "description": "Number of bits for quantization"
        }
      }
    },
    "clipping": {
      "name": "Clipping",
      "description": "Hard distortion by signal clipping",
      "parameters": {
        "threshold": {
          "name": "Threshold",
          "description": "Level at which clipping occurs"
        }
      }
    },
    "limiter": {
      "name": "Limiter",
      "description": "Prevents audio from exceeding threshold",
      "parameters": {
        "threshold": {
          "name": "Threshold",
          "description": "Maximum output level"
        },
        "release": {
          "name": "Release",
          "description": "Time to return to normal after limiting"
        }
      }
    },
    "invert": {
      "name": "Invert",
      "description": "Flips signal polarity",
      "parameters": {}
    },
    "ladderFilter": {
      "name": "Ladder Filter",
      "description": "Moog-style multimode filter",
      "parameters": {
        "cutoff": {
          "name": "Cutoff Frequency",
          "description": "Filter cutoff frequency"
        },
        "resonance": {
          "name": "Resonance",
          "description": "Filter resonance (emphasis at cutoff)"
        },
        "drive": {
          "name": "Drive",
          "description": "Amount of filter overdrive"
        },
        "mode": {
          "name": "Mode",
          "description": "Filter mode (LPF=lowpass, HPF=highpass, BPF=bandpass)"
        }
      }
    },
    "peakFilter": {
      "name": "Peak Filter",
      "description": "Parametric EQ band",
      "parameters": {
        "cutoff": {
          "name": "Frequency",
          "description": "Center frequency of the peak"
        },
        "gain": {
          "name": "Gain",
          "description": "Boost or cut at the center frequency"
        },
        "q": {
          "name": "Q Factor",
          "description": "Width of the frequency band"
        }
      }
    },
    "highShelfFilter": {
      "name": "High Shelf Filter",
      "description": "Boosts/cuts high frequencies",
      "parameters": {
        "cutoff": {
          "name": "Cutoff Frequency",
          "description": "Frequency where shelf begins"
        },
        "gain": {
          "name": "Gain",
          "description": "Amount of boost or cut"
        },
        "q": {
          "name": "Q Factor",
          "description": "Sharpness of the transition"
        }
      }
    },
    "lowShelfFilter": {
      "name": "Low Shelf Filter",
      "description": "Boosts/cuts low frequencies",
      "parameters": {
        "cutoff": {
          "name": "Cutoff Frequency",
          "description": "Frequency where shelf begins"
        },
        "gain": {
          "name": "Gain",
          "description": "Amount of boost or cut"
        },
        "q": {
          "name": "Q Factor",
          "description": "Sharpness of the transition"
        }
      }
    },
    "convolution": {
      "name": "Convolution",
      "description": "Impulse response reverb/simulation",
      "parameters": {
        "impulseResponse": {
          "name": "Impulse Response",
          "description": "Type of acoustic space to simulate"
        },
        "mix": {
          "name": "Mix",
          "description": "Balance between dry and processed signal"
        }
      }
    },
    "mp3Compressor": {
      "name": "MP3 Compressor",
      "description": "Adds MP3 compression artifacts",
      "parameters": {
        "vbrQuality": {
          "name": "VBR Quality",
          "description": "MP3 VBR quality (0=highest, 9=lowest)"
        }
      }
    },
    "gsmCompressor": {
      "name": "GSM Compressor",
      "description": "2G cellular phone compression",
      "parameters": {}
    },
    "delay": {
      "name": "Simple Delay",
      "description": "Basic delay effect",
      "parameters": {
        "delayTime": {
          "name": "Delay Time",
          "description": "Time delay for echoes"
        },
        "feedback": {
          "name": "Feedback",
          "description": "Amount of feedback for multiple echoes"
        },
        "wetLevel": {
          "name": "Wet Level",
          "description": "Level of delayed signal"
        }
      }
    }
  }
